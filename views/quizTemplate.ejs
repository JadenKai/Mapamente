<%- include('partials/header') %> <!-- Assumming I'm passed in a list of Question stored in quizQuestions and cityName -->
        <header class = "pageTitle">
            <%=cityName%>
        </header>
        <div class="questionsBox">
            <form id="quiz-form" action="/quizSubmission" method="post" > <!-- Should return: { "a questionId as a string": "chosen answerID as a string", etc } -->
                <input type="hidden" name="timeRemaining" id="time-remaining-input" value="0">
                <br>
                <% for(let q of quizQuestions) {%>
                    <fieldset class="question">
                        <legend class="questionTitle"><%= q.questionText %></legend>
                        <% for(let answer of q.answers) { %>
                            <label class="quizLabel">
                                <input type="radio" name="<%=q.questionId%>" value="<%= answer.answerId %>">
                                <%= answer.answerText %>
                            </label>
                        <% } %>
                    </fieldset><br>
                <% } %>
                <div class="center">
                    <input type="submit" value="Submit answers">
                </div>
            </form>
        </div>
        <br>
        <div class="timer-container">
            <div class="timer-track">
                <div id="timer-bar"></div>
            </div>
            <span id="time-label">30</span>
        </div>
        <script src="/js/visualTimer.js"></script>
<%- include('partials/footer') %>
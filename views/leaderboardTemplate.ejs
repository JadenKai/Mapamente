<%- include('partials/header') %> <!-- Assuming I'm handed a cityName and a list of scores -->
        <header class = "pageTitle">
            <%=cityName%> Leaderboard
        </header>
        <div class="center">
            <table class="statsTable">
                <thead>
                    <tr>
                        <th colspan="4" style="padding:5px;">Top 10 Scores</th>
                    </tr>
                    <tr>
                        <th style="padding: 5px;">Rank</th>
                        <th style="padding: 5px;">User</th>
                        <th style="padding: 5px;">Questions Correct</th>
                        <th style="padding: 5px;">Score</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let i = 0; i < scores.length; i++) { let s = scores[i]; %>
                    <tr>
                        <td style="padding: 5px; text-align: center;"><%=i+1%></td>
                        <td style="padding: 5px; text-align: center;"><%=s.username%></td>
                        <td style="padding: 5px; text-align: center;"><%=s.correctCount%> / 10</td>
                        <td style="padding: 5px; text-align: center;"><%=s.score%> pts</td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
<%- include('partials/footer') %>
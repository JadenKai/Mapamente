<!--This is for the page to select from all avaliable cities. (/cities)-->
<!--Assuming I'm handed in a list of CityEntry-->

<%- include('partials/header') %>

        <!--Page Title-->
        <header class = "pageTitle">
            Cities
        </header>

        <!--Basically a for(let c in cities) but tracking index-->
        <% for(let i = 0; i < cities.length; i++) { let c = cities[i]; %>
            <!--Every other index starts a new row-->
            <% if (i % 2 === 0) { %>
                <div class="cityRow">
            <% } %>
            <!--div cityBox is the "for each" part. There's a box for each city-->
            <div class="cityBox" style="background-image: url('/images/<%=c.cityBanner%>');">
                <p class="cityTitle">
                   <%= c.cityName %>
                </p>
                <div style="display:flex; justify-content: center;">
                    <div style="flex:1; text-align:center;">
                        <a href="/wiki/<%=c.cityId%>" style="text-decoration: none;">
                            <p class="cityBoxButtons">
                                Wiki →
                            </p>
                        </a>
                    </div>
                    <div  style="flex:1; text-align:center;">
                        <a href="/quiz/<%=c.cityId%>" style="text-decoration: none;">
                            <p class="cityBoxButtons">
                                Quiz →
                            </p>
                        </a>
                    </div>
                    <div  style="flex:1; text-align:center;">
                        <a href="/leaderboard/<%=c.cityId%>" style="text-decoration: none;">
                            <p class="cityBoxButtons">
                                Leaderboard →
                            </p>
                        </a>
                    </div>
                </div>
            </div>

            <!--Checks if this index is the end of a row or if there's no more cities-->
            <% if (i % 2 === 1 || i === cities.length - 1) { %>
                <!--The following checks if you end with an odd number of cities-->
                <% if (i === cities.length - 1 && cities.length % 2 === 1) { %>
                    <!--Adds an extra invisible box if there's an odd number of cities-->
                    <div class="cityBox" style="visibility: hidden;"></div>
                <% } %>
            </div> <!--This is in here so the row closes after two boxes-->
            <% } %>
        <%}%>

<%- include('partials/footer') %>
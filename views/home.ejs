<!--This is for the home page (/home)-->

<%- include('partials/header') %>

        <header class = "pageTitle">
            Mapamente
        </header>
        <p style="margin:10px; text-align: center;">
            Welcome to Mapamente, a website where you can learn all about
            Spanish-speaking cities around the world!
            <br>
            Then, you can test yourself with built-in quizzes and compare
            your stats to others.
            <br> <br>
        </p>
        <p style = "text-align: center;">
            Create an account to track your stats:
        </p>
        <a href="/signup" class="button">
            <button  class = "fancyButton" >
                Sign Up
            </button>
        </a>
        <p style = "text-align: center;">
            or, browse as a guest anonymously:
        </p>
        <a class = "globeContainer" href="/cities" style="margin-bottom: 20px;">
            <img class = "homeGlobe" src="/images/Globe.png" alt="Globe">
        </a>

<%- include('partials/footer') %>

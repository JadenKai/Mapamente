<!--This is for (/login-->
<%- include('partials/header') %>
        <header class = "pageTitle">
            Login
        </header>
        <div style="display:flex; justify-content: center;">
            <div class="formBox">
                <% if (locals.error) { %><p style="color: red; text-align: center;"><%= error %></p><% } %>
                <form class="form" action="/loginPlayer" method="post"> <!--This will post Username and Password string variables as {"username":"input",etc}-->
                    <label class="formText" for="username">Username:&nbsp;&nbsp;</label>
                    <input class="formInput" type="text" id="username" name="username" placeholder="player123"><br>
                    <label class="formText" for="password">Password:&nbsp;&nbsp;&nbsp;</label>
                    <input class="formInput" type="password" id="password" name="password" placeholder="*******"><br>
                    <div class="center" style="margin-top:10px;">
                        <input class="formInput" type="submit" value="Submit">
                    </div>
                </form>
            </div>
        </div>
        <p style="display:flex; justify-content: center;">
            Or if you don't have an account:
        </p>
        <a href="/signup" class="button">
            <button  class = "fancyButton">
                Sign Up
            </button>
        </a>
<%- include('partials/footer') %>

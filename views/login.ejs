<%- include('partials/header') %>
        <header class = "pageTitle">
            Login
        </header>
        <div style="display:flex; justify-content: center;">
            <div class="formBox">
                <form class="form"> <!--action="/login.player" method="post"--> 
                    <label for="username">Username:&nbsp;&nbsp;</label>
                    <input class="formInput" type="text" id="username" placeholder="player123"><br>
                    <label for="password">Password:&nbsp;&nbsp;&nbsp;</label>
                    <input type="text" id="password" placeholder="*******"><br>
                    <div class="center">
                        <input class="formInput" type="submit" value="Submit">
                    </div>
                </form>
            </div>
        </div>
        <p style="display:flex; justify-content: center;">
            Or if you don't have an account:
        </p>
        <a href="/signup" class="button">
            <button  class = "signUpButton">
                Sign Up
            </button>
        </a>
<%- include('partials/footer') %>
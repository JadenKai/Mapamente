<%- include('partials/header') %> <!-- Assumming I'm passed a CityEntry object as city -->
    <header class = "cityTitles" style="background-image: radial-gradient(rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%), url(../images/Madrid.jpg);">
        <!-- Change Madrid url to <%=city.cityBanner%> -->
        <%=city.cityName%>
    </header>
    <p class="wikiHeader">
        History
    </p>
    <p class="wikiText">
        <%=city.historyText%>
    </p>
    <br>
    <p class="wikiHeader">
        Current Facts
    </p>
    <p class="wikiText">
        <%=city.factsText%>
    </p>
    <br><br>
    <p style="text-align: center;">
            Ready to take the Quiz?
        </p>
        <a class = "button" href="/quiz/<%=city.cityId%>" style="margin-bottom: 20px;">
            <button class ="quizButton">
                Take Quiz >
            </button>
        </a>
<%- include('partials/footer') %>
<!--This is for (/signup)-->
<%- include('partials/header') %>
        <header class = "pageTitle">
            Sign Up
        </header>
        <div class="center">
            <div class="formBox">
                <% if (locals.error) { %><p style="color: red; text-align: center;"><%= error %></p><% } %>
                <form class="form" action="/addPlayer" method="post"> <!--This will post Username, Password, and PasswordCheck string variables as {"Username":"input",etc}-->
                    <label class="formText" for="username">Username: &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</label>
                    <input class="formInput" type="text" id="username" name="username" placeholder="player123"><br>
                    <label class="formText" for="password">Password: &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;</label>
                    <input class="formInput" type="password" id="password" name="password" placeholder="*******"><br>
                    <label class="formText" for="passwordCheck">Repeat Password:&nbsp;</label>
                    <input class="formInput" type="password" id="passwordCheck" name="passwordCheck" placeholder="*******"><br>
                    <div class="center" style="margin-top:10px;">
                        <input class="formInput" type="submit" value="Submit">
                    </div>
                </form>
            </div>
        </div>
        <p class="center">
            Or if you already have an account:
        </p>
        <a href="/login" class="button">
            <button  class = "fancyButton">
                Login
            </button>
        </a>
<%- include('partials/footer') %>
